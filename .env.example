# Configuración General del Proyecto
PROJECT_NAME="E-Commerce API Profesional"

# Conexión a Base de Datos (SQLite - desarrollo local)
# Para producción usa: postgresql://<usuario>:<password>@<host>:<puerto>/<nombre_db>
DATABASE_URL=sqlite:///./ecommerce.db

# Configuración de CORS (Orígenes permitidos separados por coma)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"

# Configuración de Seguridad y JWT
# Generar una clave secreta segura con: openssl rand -hex 32
SECRET_KEY="tu_clave_secreta_super_segura_para_firmar_jwt_aqui_cambiar_en_produccion"
ALGORITHM="HS256"

# Tiempos de expiración de Tokens (en minutos)
# 30 minutos para Access Token
ACCESS_MIN=30
# 7 días para Refresh Token (7 * 24 * 60 = 10080)
REFRESH_MIN=10080

# Clave secreta para auto-asignar rol de Administrador durante registro
ADMIN_SECRET_KEY="STICKER_ADMIN_2026"
